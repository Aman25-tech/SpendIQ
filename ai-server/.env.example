# SpendIQ AI service configuration — copy to .env (or set in your shell).

# Which provider produces the Insights / Explanation / Recommendations:
#   rules  = deterministic statistics, zero config (DEFAULT)
#   openai = OpenAI chat API (set OPENAI_API_KEY)
#   llama  = any OpenAI-compatible local endpoint (Ollama / llama.cpp / LM Studio)
AI_PROVIDER=rules

# Provider endpoint + model (defaults for each provider are applied if blank).
#   openai → https://api.openai.com/v1            model: gpt-4o-mini
#   llama  → http://localhost:11434/v1 (Ollama)   model: llama3.2
AI_BASE_URL=
AI_MODEL=openai
# Required only for AI_PROVIDER=openai. Local llama servers usually ignore it.
OPENAI_API_KEY=your-openai-api-key-here

# Node (server/.env) — where Node finds this service. Leave default.
AI_SERVER_URL=http://localhost:5020/analyze